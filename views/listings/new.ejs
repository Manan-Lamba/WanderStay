<%- layout("/layouts/boilerplate") %>

    <h2>Create a New Listing</h2>

    <div class="container text-center">
        <form method="POST" action="/listings" class="needs-validation" novalidate>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label for="title" class="form-label custom-label"><b>Title: </b></label>
                    <input name="title" id="title" class="form-control" placeholder="Enter the Title" required>
                    <div class="invalid-feedback">
                        Title is required.
                    </div>
                </div>
                <div class="col-md-12 mb-3">
                    <label for="description" class="form-label custom-label"><b>Description: </b></label>
                    <textarea name="description" id="description" class="form-control"
                        placeholder="Give a suitable description" required></textarea>
                    <div class="invalid-feedback">
                        Description is required.
                    </div>
                </div>
                <div class="col-md-12 mb-3">
                    <label for="image" class="form-label custom-label"><b>Image_URL: </b></label>
                    <input name="image" id="image" class="form-control" placeholder="Enter image URL" required>
                    <div class="invalid-feedback">
                        Enter a valid url.
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="price" class="form-label custom-label"><b>Price: </b></label>
                    <input name="price" id="price" class="form-control" type="number" placeholder="1400" required>
                    <div class="invalid-feedback">
                        Enter a valid Price.
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="location" class="form-label custom-label"><b>Location: </b></label>
                    <input name="location" id="location" class="form-control" placeholder="Jaipur" required>
                    <div class="invalid-feedback">
                        Location is required.
                    </div>
                </div>
                <div class="col-md-12 mb-3">
                    <label for="country" class="form-label custom-label"><b>Country: </b></label>
                    <input name="country" id="country" class="form-control" placeholder="India" required>
                    <div class="invalid-feedback">
                        Country is required.
                    </div>
                </div>
            </div>
            <button class="btn btn-primary add-btn">Add</button>
        </form>
    </div>