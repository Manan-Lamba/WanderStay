<%- layout("/layouts/boilerplate") %>

    <h2>Create a New Listing</h2>

    <div class="container text-center">
        <form method="POST" action="/listings">
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label for="title" class="form-label custom-label"><b>Title: </b></label>
                    <input name="title" id="title" class="form-control"
                    placeholder="Enter the Title">
                </div>
                <div class="col-md-12 mb-3">
                    <label for="description" class="form-label custom-label"><b>Description: </b></label>
                    <textarea name="description" id="description" class="form-control"
                    placeholder="Give a suitable description"></textarea>
                </div>
                <div class="col-md-12 mb-3">
                    <label for="image" class="form-label custom-label"><b>Image_URL: </b></label>
                    <input name="image" id="image" class="form-control"
                    placeholder="Enter image URL">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="price" class="form-label custom-label"><b>Price: </b></label>
                    <input name="price" id="price" class="form-control" type="number"
                    placeholder="1400">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="location" class="form-label custom-label"><b>Location: </b></label>
                    <input name="location" id="location" class="form-control"
                    placeholder="Jaipur">
                </div>
                <div class="col-md-12 mb-3">
                    <label for="country" class="form-label custom-label"><b>Country: </b></label>
                    <input name="country" id="country" class="form-control"
                    placeholder="India">
                </div>
            </div>
            <button class="btn btn-primary add-btn">Add</button>
        </form>
    </div>